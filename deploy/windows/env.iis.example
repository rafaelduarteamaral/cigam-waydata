NODE_ENV=production
TZ=America/Sao_Paulo

# URLs oficiais. Tokens NÃO vão neste arquivo no WhatsApp: o cliente cola no servidor.
CIGAM_BASE_URL=https://panebrasportais.cigam.cloud/API_ERP/api/API.asmx
CIGAM_TOKEN=
CIGAM_AUTH_SCHEME=raw
CIGAM_API_STYLE=asmx
CIGAM_UNIT=001
CIGAM_LOOKBACK_DAYS=4
CIGAM_PENDING_ROUTES_PATH=/Cargas_Buscar
CIGAM_ROUTE_PATH=/Cargas_BuscarDetalhes
CIGAM_STATUS_PATH=/Cargas_MudaSituacao
CIGAM_TRACKING_PATH=/Acompanhamento_Criar
CIGAM_ATTACHMENT_PATH=/Acompanhamento_Criar
CIGAM_COMPANIES_PATH=/Empresas

# Homologação WayData. Produção: https://restrito.waydatasolution.com.br/... só após aceite.
WAYDATA_BASE_URL=https://wayds.net/integraway/api/v1
WAYDATA_TOKEN=

# No IIS comece em read_only. write só depois do aceite.
SYNC_ENABLED=true
SYNC_MODE=read_only
SYNC_INTERVAL_SECONDS=300
SYNC_CONCURRENCY=4
HTTP_TIMEOUT_MS=30000
MAX_RETRIES=5
DELIVERY_LOOKBACK_DAYS=4

DATA_DIRECTORY=C:\apps\cigam-waydata\data
LOG_RETENTION_DAYS=180

# Build do monitor no IIS (subcaminho do portal). Sem isso, CSS e /api caem no site CIGAM.
NEXT_PUBLIC_BASE_PATH=/WayData/monitor

MONITOR_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
