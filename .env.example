NODE_ENV=development
TZ=America/Sao_Paulo

CIGAM_BASE_URL=http://localhost:4010
CIGAM_TOKEN=
WAYDATA_BASE_URL=https://wayds.net/integraway/api/v1
WAYDATA_TOKEN=

SYNC_ENABLED=false
# disabled | read_only | write
SYNC_MODE=disabled
SYNC_INTERVAL_SECONDS=300
SYNC_CONCURRENCY=4
HTTP_TIMEOUT_MS=30000
MAX_RETRIES=5
DELIVERY_LOOKBACK_DAYS=4

# Contratos oficiais ASMX da collection PANEBRAS. Deixe CIGAM_API_STYLE=asmx.
CIGAM_API_STYLE=asmx
CIGAM_AUTH_SCHEME=raw
CIGAM_UNIT=001
CIGAM_LOOKBACK_DAYS=4
CIGAM_MAX_PAGES=50
CIGAM_PENDING_ROUTES_PATH=/Cargas_Buscar
CIGAM_ROUTE_PATH=/Cargas_BuscarDetalhes
CIGAM_STATUS_PATH=/Cargas_MudaSituacao
CIGAM_TRACKING_PATH=/Acompanhamento_Criar
CIGAM_ATTACHMENT_PATH=/Acompanhamento_Criar
CIGAM_COMPANIES_PATH=/Empresas
CIGAM_ROUTING_CODE_PATH=/CargasGravaRoteirizacao

DATA_DIRECTORY=./data
LOG_RETENTION_DAYS=180

# Proteção do monitor. Use uma chave aleatória longa para MONITOR_AUTH_SECRET.
MONITOR_USERNAME=
MONITOR_PASSWORD=
MONITOR_AUTH_SECRET=

# Downloads de canhoto ficam em memória. Qualquer arquivo residual em DATA_DIRECTORY/tmp/receipts é removido na retenção.

# Homologação controlada. SYNC_ROUTE_IDS limita as cargas; SYNC_MAX_ROUTES corta o lote.
# SYNC_ROUTE_IDS=36858
# SYNC_MAX_ROUTES=1

# Opcional quando o monitor estiver atrás de autenticação interna/reverse proxy.
MONITOR_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
